APP_NAME="SaaS Barbearia"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://plataforma-agendamentos.vercel.app

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=sqlite
DB_DATABASE=/tmp/database.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@glowsystem.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (produção — obter em resend.com)
RESEND_KEY=

# Make.com — Webhook que sincroniza agendamentos com o Google Calendar
MAKE_AGENDAMENTO_WEBHOOK_URL=

# Make.com — Token compartilhado para autenticar o envio de eventos do Calendar de volta à plataforma
MAKE_CALENDAR_SYNC_TOKEN=

# WhatsApp API (Z-API ou Evolution API)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_INSTANCE=

# MercadoPago (para planos)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
